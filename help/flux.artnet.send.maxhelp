                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 287.0, 650.0, 155.0, 74.0 ],
                                    "text": "When framerate is 0 (default), frames are sent out only on change. If set, frames are output at the given frames/sec."
                                }
                            },
                            {
                                "box": {
                                    "id": "obj-87",
                                    "linecount": 5,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 289.0, 573.0, 155.0, 74.0 ],
                                    "text": "When no host is specified, the universes are broadcast, while specifying the host IP unicasts, which is more efficient."
                                }
                            },
